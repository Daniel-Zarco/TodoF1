# ============================================================
# TodoF1 - Enrutamiento de la raiz web (www/)
# Lo publica deploy/deploy.sh en la raiz del sitio.
#
#   /                              -> pagina principal (misma URL, 200)
#   /index.html/index.html         -> 301 a /
#   /index.html/                   -> 301 a /
#   /index.html/PagePrincipal.php  -> 301 a /
#   /index.php                     -> 301 a /
#
# El resto de URLs (index.html/Page*.php, Images/, api/) se sirven
# como hasta ahora.
#
# Nota: este archivo se guarda sin BOM y solo con caracteres ASCII;
# alwaysdata advierte de que un BOM invalida el .htaccess.
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- HTTPS obligatorio (Alwaysdata termina TLS en su proxy) ----
    # Solo se redirige cuando el proxy indica explicitamente "http". Asi una
    # peticion HTTPS (X-Forwarded-Proto=https) o sin cabecera no entra en un
    # bucle. Se conserva la ruta y la query string.
    RewriteCond %{HTTP:X-Forwarded-Proto} ^http$ [NC]
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
    RewriteRule ^ https://todof1.alwaysdata.net%{REQUEST_URI} [R=301,L]

    # ---- URLs antiguas -> raiz (301 permanente) ----
    RewriteRule ^index\.html/index\.html$ / [R=301,L]
    RewriteRule ^index\.html/?$ / [R=301,L]

    # La pagina principal antigua redirige a la raiz unicamente en peticiones
    # externas: %{THE_REQUEST} no cambia con los rewrites internos, asi que
    # esta condicion impide cualquier bucle (el "/" servido internamente
    # tambien acaba apuntando a este archivo).
    RewriteCond %{THE_REQUEST} \s/+index\.html/PagePrincipal\.php[?\s]
    RewriteRule ^index\.html/PagePrincipal\.php$ / [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+index\.php[?\s]
    RewriteRule ^index\.php$ / [R=301,L]

    # ---- La raiz sirve la pagina principal sin cambiar la URL ----
    # El servidor puede resolver "/" con el DirectoryIndex antes de aplicar
    # estas reglas, por lo que se cubren las dos formas posibles.
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ /index.html/PagePrincipal.php [L]

    RewriteCond %{REQUEST_URI} ^/(index\.php)?$
    RewriteRule ^index\.php$ /index.html/PagePrincipal.php [L]
</IfModule>
